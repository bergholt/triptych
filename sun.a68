# ========================================================================
  SUN
  ========================================================================

  sun.a68
  Sun: 72 Poems for the Solar Eclipse of August 12th 2026
  After the glossematic and acoustic architecture of https://bergholt.net/sun
  An ALGOL 68 realisation of sun.pl (github.com/bergholt/triptych, MIT
  license), made from the ALGOL 60 version sun.alg.

  ALGOL 68 Genie (a68g), upper stropping, no libraries. Tested with
  a68g 2.8.4 and 3.1.2.

  ONLINE : paste the whole file into JDoodle (Algol 68) and press Execute.
  RUN    : a68g sun.a68
  EDITION: set by the line  INT edition := saros  below, or on the command
           line after --exit, as in  a68g sun.a68 --exit sounding
           (manifestations, saros, glossematic, mutation, sounding).

  From ALGOL 60 to ALGOL 68.
    ALGOL 60 could print a string but never take one apart, so sun.alg
    spells every word letter by letter, one procedure per letter. ALGOL 68
    has strings that can be indexed, so here the words are written as
    words again, and the letters (figurae, the small closed stock of
    sub-elements a word is built from) are read out of them only where the
    sounding rule needs them: alphabet position = ABS letter - ABS "a" + 1.

    Everything else keeps the shape of sun.alg. A cell of the grid is a row
    of four indices, one per category. The two directions of selection/5
    are selection (an ordinal decoded through the strides) and encode (the
    same strides multiplied back), and cells is the inventory enumerated in
    the order Prolog finds the solutions. Where Prolog fails, these
    procedures give an empty row or an empty string.

    Nothing numerical is written into the generator. Cardinalities are the
    bounds of the inventory rows, strides are multiplied from them,
    intervals are read from the Saros table, spectra are counted from the
    letters. The eleven checks of sun.pl's self_check then hold the derived
    values to the numbers the work asserts, before anything is printed. A
    failing check prints sun_check_failed(label) and stops.

    Gamma is stored as an integer in ten-thousandths (-1.5356 is -15356),
    the precision the Prolog table and printer use, so no real arithmetic
    is involved.

    The inventory order is part of the artwork: changing it changes eclipse
    assignments. Astronomical data and the epigraph are retained from the
    original, and the checks validate structure, not external accuracy.
    ASCII output, and dates use the original Julian and Gregorian catalogue
    convention.

  Two findings the sounding rule yields that the essay does not state:
    recursively touches partial 1 once (its final y, 25 mod 12), and
    thicken never touches partial 1 at all (t h i c k e n = 8 8 9 3 11 5 2).
    The words that leave the drone hanging are therefore exactly the two
    Germanic cells. The sounding check asserts that equivalence. Under a
    literal mod 12 the letter l (12) yields partial 0, printed as a silence.
#

# The edition printed #
INT manifestations = 1, saros = 2, glossematic = 3, mutation = 4, sounding = 5;
INT edition := saros;

# ============================================================
  I. GLOSSEMATIC INVENTORY
  ============================================================ #

# The categories, in the order sun.pl declares them #
INT noun = 1, verb = 2, adverb = 3, order = 4;
[]STRING category name = ("noun", "verb", "adverb", "order");
[]INT lexical = (noun, verb, adverb);

# Paradigmatic invariants: 3 x 3 x 4 = 36 commutable selections.
  Syntagmatic invariants: 2 orders permute 36 to 72.
  The position of each word in its row is its index, counted from 0. #
[][]STRING inventory = (
   ("apertures", "auguries", "apparitions"),
   ("align", "thicken", "emerge"),
   ("rhythmically", "vertically", "recursively", "now"),
   ("suffix", "prefix"));

PROC len = (STRING s) INT: UPB s - LWB s + 1;
PROC cardinality = (INT cat) INT: UPB inventory[cat];
PROC invariant = (INT cat, idx) STRING: inventory[cat][idx + 1];

# The lexicon: word, register, reference, mode. Latinate covers Greek. #
INT latinate = 1, germanic = 2;
INT autonomous = 1, deictic = 2;
INT event = 1, action = 2, manner = 3, tactile density = 4, temporal utterance = 5;
MODE META = STRUCT (STRING word, INT register, reference, mode);
[]META lexicon meta = (
   ("apertures",    latinate, autonomous, event),
   ("auguries",     latinate, autonomous, event),
   ("apparitions",  latinate, autonomous, event),
   ("align",        latinate, autonomous, action),
   ("emerge",       latinate, autonomous, action),
   ("rhythmically", latinate, autonomous, manner),
   ("vertically",   latinate, autonomous, manner),
   ("recursively",  latinate, autonomous, manner),
   ("thicken",      germanic, autonomous, tactile density),
   ("now",          germanic, deictic,    temporal utterance));

# The entry of a word in the lexicon, or 0 #
PROC meta of = (STRING w) INT:
BEGIN
   INT found := 0;
   FOR ix TO UPB lexicon meta DO
      IF word OF lexicon meta[ix] = w THEN found := ix FI
   OD;
   found
END;

# ============================================================
  II. EXPRESSION-FORM: CARDINALITY AND STRIDE

  The categories are not distinguished by part of speech. They are
  distinguished by how far a commutation carries you through the cycle.
  Stride: ordinals moved by one step within a category. Derived.
  ============================================================ #

PROC stride = (INT cat) INT:
   IF cat = adverb THEN 1
   ELIF cat = verb THEN cardinality (adverb)
   ELIF cat = noun THEN cardinality (adverb) * cardinality (verb)
   ELSE cardinality (adverb) * cardinality (verb) * cardinality (noun)
   FI;

PROC system cardinality = INT:
BEGIN
   INT product := 1;
   FOR cat TO UPB inventory DO product *:= cardinality (cat) OD;
   product
END;

# ============================================================
  III. SELECTION (BOTH DIRECTIONS)

  A cell is a row of four indices, in category order.
  ============================================================ #

MODE CELL = [1 : 4] INT;
[]INT none = ();

# A bound ordinal decodes directly. Outside the grid there is no cell. #
PROC selection = (INT num) []INT:
   IF num < 1 OR num > system cardinality THEN none
   ELSE
      INT k = num - 1;
      INT oi = k OVER stride (order), r1 = k MOD stride (order);
      INT ni = r1 OVER stride (noun), r2 = r1 MOD stride (noun);
      INT vi = r2 OVER stride (verb), ai = r2 MOD stride (verb);
      (ni, vi, ai, oi)
   FI;

# A cell encodes by the same strides, so the mapping cannot drift
  between directions #
PROC encode = ([]INT cell) INT:
BEGIN
   INT sum := 1;
   FOR cat TO UPB cell DO sum +:= cell[cat] * stride (cat) OD;
   sum
END;

# The word a cell selects in a category #
PROC cell word = ([]INT cell, INT cat) STRING: invariant (cat, cell[cat]);

# An unbound ordinal enumerates the inventory and encodes, in the order
  Prolog would find the solutions: order, noun, verb, adverb #
INT ncells = system cardinality;
[1 : ncells] CELL cells;
[1 : ncells] INT ordinals;
BEGIN
   INT count := 0;
   FOR oi FROM 0 TO cardinality (order) - 1 DO
   FOR ni FROM 0 TO cardinality (noun) - 1 DO
   FOR vi FROM 0 TO cardinality (verb) - 1 DO
   FOR ai FROM 0 TO cardinality (adverb) - 1 DO
      count +:= 1;
      cells[count] := (ni, vi, ai, oi);
      ordinals[count] := encode (cells[count])
   OD OD OD OD
END;

# ============================================================
  IV. SYNTAGMATIC FUNCTION AND MANIFESTATION
  ============================================================ #

PROC syntagmatic function = ([]INT cell) STRING:
BEGIN
   STRING o = cell word (cell, order);
   STRING n = cell word (cell, noun), v = cell word (cell, verb),
          a = cell word (cell, adverb);
   IF o = "suffix" THEN n + " " + v + " " + a
   ELIF o = "prefix" THEN a + ", " + n + " " + v
   ELSE ""
   FI
END;

# The poem of an ordinal, or the empty string where there is none #
PROC manifestation = (INT num) STRING:
BEGIN
   []INT cell = selection (num);
   IF UPB cell = 0 THEN "" ELSE syntagmatic function (cell) FI
END;

PROC poem = (INT num) STRING: manifestation (num);

PROC append = (REF FLEX [] INT row, INT x) VOID:
BEGIN
   INT n = UPB row;
   [1 : n + 1] INT grown;
   grown[1 : n] := row;
   grown[n + 1] := x;
   row := grown
END;

# poem(N, Text) with Text bound: the poem read back to its ordinal(s) #
PROC poems of = (STRING text) []INT:
BEGIN
   FLEX [1 : 0] INT hits;
   FOR ix TO ncells DO
      IF syntagmatic function (cells[ix]) = text THEN append (hits, ordinals[ix]) FI
   OD;
   hits
END;

# ============================================================
  V. CONTENT-FORM: SAROS 126 (1179 J - 2459)
  ============================================================ #

INT partial = 1, annular = 2, hybrid = 3, total = 4;
[]STRING type name = ("partial", "annular", "hybrid", "total");

# ordinal, year, month, day, type, gamma (ten-thousandths) #
MODE ECLIPSE = STRUCT (INT ordinal, year, month, day, type, gamma);
[]ECLIPSE saros table = (
   ( 1, 1179,  3, 10, partial, -15356),
   ( 2, 1197,  3, 20, partial, -14880),
   ( 3, 1215,  3, 31, partial, -14344),
   ( 4, 1233,  4, 11, partial, -13717),
   ( 5, 1251,  4, 22, partial, -13041),
   ( 6, 1269,  5,  2, partial, -12291),
   ( 7, 1287,  5, 14, partial, -11500),
   ( 8, 1305,  5, 24, partial, -10658),
   ( 9, 1323,  6,  4, annular,  -9799),
   (10, 1341,  6, 14, annular,  -8922),
   (11, 1359,  6, 26, annular,  -8038),
   (12, 1377,  7,  6, annular,  -7168),
   (13, 1395,  7, 17, annular,  -6318),
   (14, 1413,  7, 27, annular,  -5506),
   (15, 1431,  8,  8, annular,  -4737),
